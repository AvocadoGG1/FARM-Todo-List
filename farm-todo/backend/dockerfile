# 1. PIN THE VERSION: Change python:3 to python:3.11 or 3.12
# This ensures you use a version compatible with all your pre-compiled wheels.
FROM python:3.11

WORKDIR /usr/src/app

COPY requirements.txt ./

# 2. UPGRADE PIP FIRST: 
# Old pip versions sometimes can't see the newer wheels for libraries like pydantic-core.
RUN pip install --upgrade pip && \
    pip install --no-cache-dir --upgrade -r ./requirements.txt

EXPOSE 3001

CMD [ "python", "./src/server.py" ]